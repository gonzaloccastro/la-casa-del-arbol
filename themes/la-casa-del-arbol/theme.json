{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "color": true,
      "radius": false,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1376px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "gradients": [],
      "duotone": [],
      "link": true,
      "palette": [
        { "slug": "ink", "color": "#171717", "name": "Tinta" },
        { "slug": "paper", "color": "#FCFAF6", "name": "Papel" },
        { "slug": "white", "color": "#FFFFFF", "name": "Blanco" },
        { "slug": "red", "color": "#EF3323", "name": "Rojo Casa" },
        { "slug": "mint", "color": "#B8DDBF", "name": "Menta" },
        { "slug": "yellow", "color": "#F2C45E", "name": "Amarillo" },
        { "slug": "placeholder", "color": "#E7E3D9", "name": "Placeholder" },
        { "slug": "body-muted", "color": "#3A3A3A", "name": "Texto secundario" },
        { "slug": "body-soft", "color": "#5A5A5A", "name": "Texto suave" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "10", "size": "var(--lcda-space-10, 8px)", "name": "XS · 8" },
        { "slug": "20", "size": "var(--lcda-space-20, 16px)", "name": "S · 16" },
        { "slug": "30", "size": "var(--lcda-space-30, 24px)", "name": "M · 24" },
        { "slug": "40", "size": "var(--lcda-space-40, 32px)", "name": "L · 32 (móvil 18)" },
        { "slug": "50", "size": "var(--lcda-space-50, 48px)", "name": "XL · 48 (móvil 32)" },
        { "slug": "60", "size": "var(--lcda-space-60, 64px)", "name": "2XL · 64 (móvil 40)" }
      ]
    },
    "typography": {
      "fluid": false,
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Anton)",
          "fontFamily": "Anton, Impact, Haettenschweiler, 'Arial Narrow Bold', 'Roboto Condensed', sans-serif-condensed, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Anton",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/anton/anton-400-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "ui",
          "name": "UI (Archivo)",
          "fontFamily": "Archivo, 'Helvetica Neue', Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Archivo",
              "fontWeight": "800 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/archivo/archivo-800-900-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "nav",
          "name": "Navegación (Jost)",
          "fontFamily": "Jost, Futura, 'Century Gothic', 'Avenir Next', 'Trebuchet MS', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Jost",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/jost/jost-600-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "body",
          "name": "Texto (Work Sans)",
          "fontFamily": "'Work Sans', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Work Sans",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/work-sans/work-sans-400-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Pequeño" },
        { "slug": "medium", "size": "1rem", "name": "Base" },
        { "slug": "large", "size": "clamp(1.6rem, 3vw, 2.2rem)", "name": "Título chico" },
        { "slug": "x-large", "size": "clamp(2rem, 4vw, 3.2rem)", "name": "Título de sección" },
        { "slug": "xx-large", "size": "clamp(2.2rem, 4.6vw, 4rem)", "name": "Título de evento" },
        { "slug": "display", "size": "clamp(3rem, 7vw, 6rem)", "name": "Display" }
      ]
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)"
    },
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "0.95",
          "textTransform": "uppercase"
        }
      },
      "h1": {
        "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
      },
      "h2": {
        "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ui)",
          "fontSize": "1.1875rem",
          "fontWeight": "900",
          "lineHeight": "1.12"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ui)",
          "fontSize": "1rem",
          "fontWeight": "900",
          "lineHeight": "1.15"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ui)",
          "fontSize": "0.875rem",
          "fontWeight": "900",
          "lineHeight": "1.15"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ui)",
          "fontSize": "0.8125rem",
          "fontWeight": "800",
          "lineHeight": "1.15",
          "letterSpacing": "0.08em"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--red)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--ink)" }
        }
      },
      "button": {
        "border": { "radius": "0", "width": "0" },
        "color": {
          "background": "var(--wp--preset--color--red)",
          "text": "var(--wp--preset--color--white)"
        },
        "spacing": {
          "padding": { "top": "16px", "right": "28px", "bottom": "16px", "left": "28px" }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ui)",
          "fontSize": "0.84375rem",
          "fontWeight": "900",
          "letterSpacing": "0.03em",
          "textTransform": "uppercase"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--red)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      }
    }
  }
}
